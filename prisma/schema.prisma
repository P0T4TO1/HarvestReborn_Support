// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Ticket {
  id_ticket String       @id @default(cuid())
  tipo      Tipo
  area      TipoPregunta
  estado    Estado
  prioridad Prioridad
  email     String?

  motivo       String
  descripcion  String    @db.Text
  fecha_inicio DateTime
  fecha_cierre DateTime?

  respuesta String? @db.Text

  comentarios TicketComentario[]
  respuestas  TicketRespuestas[]

  id_user String?

  id_support String?
}

model TicketRespuestas {
  id_respuesta Int @id @default(autoincrement())

  id_ticket String
  ticket    Ticket @relation(fields: [id_ticket], references: [id_ticket])

  respuesta String   @db.Text
  fecha     DateTime

  @@index([id_ticket])
}

model TicketComentario {
  id_comentario Int @id @default(autoincrement())

  id_ticket String
  ticket    Ticket @relation(fields: [id_ticket], references: [id_ticket])

  comentario String   @db.Text
  fecha      DateTime

  @@index([id_ticket])
}

enum Tipo {
  INCIDENCIA
  PETICION
  QUEJA
  RECLAMACION
}

enum Estado {
  ABIERTO
  EN_PROCESO
  CERRADO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  INMEDIATA
}

model RespuestasFaq {
  id_faqRespuesta Int @id @default(autoincrement())

  id_prefrec Int
  pregunta   PreguntasFrecuentes @relation(fields: [id_prefrec], references: [id_prefrec])

  respuesta String

  @@index([id_prefrec])
}

model PreguntasFrecuentes {
  id_prefrec Int @id @default(autoincrement())

  pregunta String

  respuestas RespuestasFaq[]
  tipo       TipoPregunta    @default(GENERAL)
}

enum TipoPregunta {
  GENERAL
  CUENTA
  NEGOCIO
  CLIENTE
  DUENONEGOCIO
  ORDENES
  PRODUCTOS
  INVENTARIO
  CHAT
  PUBLICACIONES
  TECNICO
}
